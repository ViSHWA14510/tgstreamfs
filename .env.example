# Your bot backend URL (Render/Heroku/VPS URL where bot.py runs)
BOT_BACKEND_URL=https://your-bot-backend.onrender.com

# Your Telegram bot username (without @) — for File Store links
NEXT_PUBLIC_BOT_USERNAME=YourBotUsername

# Site branding
NEXT_PUBLIC_SITE_NAME=FileStore
NEXT_PUBLIC_SITE_TAGLINE=Store, Share & Stream Files via Telegram
